---
import { Image } from 'astro:assets';

const { slug, title, image } = Astro.props;
---

<figure class="shrink-0 w-full relative">
  <div class="relative">
    <a href={`/project/${slug}`} class="no-underline relative block" aria-label={title}>
      <span class="relative block transition duration-500 ease-in-out transform rounded-3xl hover:scale-105 aspect-square overflow-hidden">
        <Image width={800} densities={[1, 2]} class="relative block object-cover object-center w-full h-full" loading="lazy" alt={title} src={image} />
      </span>
    </a>
  </div>
  <figcaption class="py-4 text-center">
    <h3 class="text-sand text-lg md:text-xl m-0 font-normal tracking-wide lowercase">
      <a href={`/project/${slug}`} class="no-underline relative inline-block hover:text-bronze transition-colors" aria-label={title}>{title}</a>
    </h3>
  </figcaption>
</figure>
