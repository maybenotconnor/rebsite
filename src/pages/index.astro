---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

import headshot from '../assets/headshot.jpg';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => {
  const yearA = parseInt(a.data.date.split('-').pop());
  const yearB = parseInt(b.data.date.split('-').pop());
  return yearB - yearA;
});
---

<Layout title="Rebecca May Ristow | Theatre Artist & Administrator">
  <div class="relative">
    <div class="mx-auto px-8 md:max-w-7xl">

      <!-- Hero Section -->
      <section class="py-12 md:py-20">
        <h1 class="font-heading text-5xl md:text-7xl font-bold tracking-wide mb-12">Rebecca May Ristow</h1>
        <div class="flex flex-col md:flex-row gap-10 md:gap-16 items-start">
          <div class="w-full md:w-1/3 shrink-0">
            <Image src={headshot} alt="Rebecca May Ristow" width={400} class="w-full h-auto" />
            <p class="text-xs text-zinc-400 mt-2">Photo: Daniel Gallipoli</p>
          </div>
          <div class="flex-1">
            <h2 class="font-heading text-2xl md:text-3xl font-light tracking-wide mb-6">Theatre Artist & Administrator</h2>
            <div class="space-y-4 text-zinc-700 leading-relaxed">
              <p>Rebecca May Ristow is a Hartford based production manager, producer, and director. She is currently developing new works and managing productions at The Bushnell Center for the Performing Arts, serving as Assistant Manager of Producing and Production. She is a Summa Cum Laude graduate with both a BA in Theatre (Directing & Dramaturgy) and an MBA (Marketing).</p>
              <p>Outside of The Bushnell, Rebecca is a frequent collaborator in the Greater Hartford arts sphere, producing independent films, assistant directing at TheaterWorks and Hartford Stage, and volunteering with various local non-profits. Previous to her current role, she spent three years as a manager in the performance operations department at University of Hartford, specializing in patron communication and outreach.</p>
              <p>She is most passionate about life-long learning and growing accessibility within the arts community!</p>
            </div>
            <div class="mt-8">
              <a href="/portfolio" class="inline-block border border-zinc-900 px-6 py-3 text-sm tracking-wide hover:bg-sage-700 hover:border-sage-700 hover:text-white transition-colors">View Portfolio</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Portfolio Preview Section -->
      <section class="py-12 md:py-20 border-t border-zinc-200">
        <h2 class="font-heading text-3xl md:text-4xl font-light tracking-wide text-center mb-4">My Project Portfolio</h2>
        <div class="text-center mb-4">
          <h3 class="font-heading text-lg font-light tracking-wide">Explore My Work</h3>
        </div>
        <p class="text-center text-zinc-600 mb-12 max-w-lg mx-auto">Head to my portfolio to see a selection of my theatrical and film projects!</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projects.map((project) => (
            <Card slug={project.slug} title={project.data.title} image={project.data.image} tags={project.data.tag} />
          ))}
        </div>
        <div class="text-center mt-12">
          <a href="/portfolio" class="inline-block border border-zinc-900 px-6 py-3 text-sm tracking-wide hover:bg-sage-700 hover:border-sage-700 hover:text-white transition-colors">View More Projects</a>
        </div>
      </section>

    </div>
  </div>
</Layout>
