---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume | R.M. Ristow">
  <div class="relative">
    <div class="mx-auto px-8 md:max-w-7xl">
      <section class="py-12 md:py-16">
        <div class="text-center mb-12">
          <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase tracking-wide text-bronze mb-8">Resume</h1>
          <a href="/resume.pdf" target="_blank" rel="noopener" class="inline-block bg-sand text-bronze rounded-full px-8 py-2.5 text-sm font-semibold tracking-widest uppercase hover:bg-sand-dark transition-colors no-underline">Download Resume</a>
        </div>
        <div class="w-full aspect-[8.5/11] max-w-4xl mx-auto">
          <object data="/resume.pdf" type="application/pdf" class="w-full h-full min-h-[600px] md:min-h-[800px]">
            <p class="text-sand">Your browser doesn't support embedded PDFs. <a href="/resume.pdf" class="underline text-bronze">Download the resume</a> instead.</p>
          </object>
        </div>
      </section>
    </div>
  </div>
</Layout>
