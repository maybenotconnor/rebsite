---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout title="Portfolio | R.M. Ristow">
  <div class="relative">
    <div class="mx-auto px-8 md:max-w-7xl">
      <section class="py-12 md:py-16">
        <h1 class="font-heading text-4xl md:text-6xl font-bold uppercase tracking-wide text-bronze text-center mb-16">Project Portfolio</h1>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10 max-w-5xl mx-auto">
          {projects.map((project) => (
            <Card slug={project.slug} title={project.data.title} image={project.data.image} />
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>
